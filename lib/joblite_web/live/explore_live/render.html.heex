<div id="joblite-explore" class="jf-app">
  <div class="jf-shell">
    <main id="main" class="jf-explore">
      <h1>Explore boards</h1>
      <p class="jf-explore-intro">Explore job boards and search for jobs directly on their websites.</p>

      <form
        id="explore-filters"
        class="jf-filters"
        phx-change="boards:filter"
        phx-submit="boards:filter"
        role="search"
        aria-label="Filter job boards"
      >
        <label class="jf-field">
          <span>Search boards</span>
          <input
            type="search"
            name="text"
            value={@filters.text}
            placeholder="Search by board name"
            autocomplete="off"
            aria-label="Search boards by name"
          />
        </label>
        <label class="jf-field">
          <span>Region</span>
          <select name="region" aria-label="Filter by region">
            <option value="">Global</option>
            <option value="africa" selected={@filters.region == "africa"}>Africa</option>
            <option value="europe" selected={@filters.region == "europe"}>Europe</option>
            <option value="north_america" selected={@filters.region == "north_america"}>North America</option>
            <option value="latin_america" selected={@filters.region == "latin_america"}>Latin America</option>
            <option value="asia_pacific_mena" selected={@filters.region == "asia_pacific_mena"}>Asia-Pacific/MENA</option>
            <option value="global" selected={@filters.region == "global"}>Global coverage</option>
          </select>
        </label>
      </form>

      <p id="explore-notice" class="jf-notice" role="status" aria-live="polite">{@notice}</p>

      <.async_result :let={directory} assign={@directory}>
        <:loading>
          <p class="jf-explore-state" aria-live="polite">Loading boards…</p>
        </:loading>
        <:failed :let={_failure}>
          <p class="jf-explore-state" role="alert">Something went wrong loading boards. Try again.</p>
        </:failed>
        <div :if={directory == []} class="jf-explore-state">
          <h2>No boards match</h2>
          <p>Try a different search or region.</p>
          <a class="jf-explore-clear" href="/explore">Clear filters</a>
        </div>
        <div :if={directory != []} class="jf-board-list">
          <.board_card
            :for={board <- directory}
            board={board}
            saved={MapSet.member?(@saved_ids, board.id)}
            id_prefix="explore"
          />
        </div>
      </.async_result>
    </main>
  </div>
</div>
